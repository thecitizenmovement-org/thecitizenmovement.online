# Scam Intel v3.0 — Phase 1 backend environment (TEMPLATE — no real values)
# Copy to .env and fill in. NEVER commit a filled-in .env to any repo.
# NEVER print these values. The service_role key bypasses RLS — keep it
# in the backend environment only.

# Bearer token the store frontend / callers must send.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SCAMINTEL_API_TOKEN=

# Supabase project (scam-intel): https://fcfsxgxqsownfywaokdp.supabase.co
SUPABASE_URL=https://fcfsxgxqsownfywaokdp.supabase.co

# Supabase service_role key (from the project Settings > API).
# This key bypasses RLS. Backend environment ONLY.
SUPABASE_SERVICE_KEY=

# Port (default 8000). Binds 127.0.0.1 only — never expose publicly.
SCAMINTEL_PORT=8000

# Tool paths (defaults shown; override only if installed elsewhere).
PHONEINFOGA_BIN=./tools/phoneinfoga
SUBFINDER_BIN=./tools/subfinder
MAIGRET_BIN=maigret
USER_SCANNER_BIN=user-scanner

# Numverify (free apilayer key) — unlocks the backend's DIRECT Numverify
# API call (api.apilayer.net/numverify/api/validate) for carrier/line-type.
# Leave blank and that step is SKIP (never fake clean). PhoneInfoga's
# built-in numverify scanner is NOT used (dead endpoint).
# GATE (Phase 1.4): the call is OFF by default — NUMVERIFY_ENABLED must be
# explicitly "true" for /scan/phone to call Numverify at all. The free
# plan caps at 100 requests/month and the free tools already cover phone
# checks, so the step reports SKIP and no quota is burned when the flag
# is off. The key stays set in Render; the flag only gates the call.
NUMVERIFY_API_KEY=
NUMVERIFY_ENABLED=false

# Geocodio (free geocod.io key, 2,500 lookups/day, no card) — unlocks
# POST /address/verify's primary check (api.geocod.io/v2.1/geocode).
# Leave blank and the endpoint falls back to the US Census Geocoder
# (free, no key) — the Geocodio step is SKIP, never a fake clean.
GEOCODIO_API_KEY=

# Nominatim User-Agent (must identify the application; free, no key).
NOMINATIM_USER_AGENT=ScamIntel/3.0 (thecitizenmovement.store)

# Maigret top-sites subset (full 509-site run takes ~3-4 min).
MAIGRET_TOP_SITES=50
MAIGRET_TIMEOUT=180
PHONEINFOGA_TIMEOUT=90
# user-scanner email run (220 modules) takes ~80 s; 240 s is the cap.
USER_SCANNER_TIMEOUT=240
SUBFINDER_TIMEOUT=90
SUBFINDER_MAX_RESULTS=500
# Noisy subfinder sources to exclude (anubis/crtname/subdomaincenter
# return tens of thousands of synthetic subdomains for ordinary domains).
SUBFINDER_EXCLUDE_SOURCES=anubis,crtname,subdomaincenter
HTTP_TIMEOUT=15
MAX_CONCURRENT_SCANS=3
